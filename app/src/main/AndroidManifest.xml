<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No permissions needed: ROMs come in through the system file picker
         (Storage Access Framework) and everything lives in app-private storage,
         which is what Android 11 (SDK 30) scoped storage expects. -->

    <application
        android:name=".PaperboyApp"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Handles rotation itself so the emulator keeps running when the tablet turns. -->
        <activity
            android:name=".GameActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="false"
            android:theme="@style/GameTheme" />
    </application>
</manifest>
